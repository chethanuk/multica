{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": { "type": "string" },
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": ["string", "object"] }
        },
        "commonLabels": { "type": "object" },
        "domain": { "type": "string" }
      },
      "additionalProperties": true
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      },
      "additionalProperties": true
    },
    "frontend": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "existingSecret": { "type": "string" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" }
          },
          "required": ["repository"]
        },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "port": { "type": "integer", "minimum": 1 }
          },
          "required": ["port"]
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": { "type": "object" },
            "hosts": { "type": "array" },
            "tls": { "type": "array" }
          }
        }
      },
      "required": ["enabled", "image", "service"]
    },
    "backend": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "existingSecret": { "type": "string" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" }
          },
          "required": ["repository"]
        },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "port": { "type": "integer", "minimum": 1 }
          },
          "required": ["port"]
        }
      },
      "required": ["enabled", "image", "service"]
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "existingSecret": { "type": "string" },
        "passwordKey": { "type": "string" }
      },
      "required": ["enabled", "port", "name", "passwordKey"]
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "required": ["enabled"]
    },
    "migrations": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "annotations": { "type": "object" }
      },
      "required": ["enabled", "backoffLimit"]
    },
    "storage": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["s3", "local"]
        },
        "existingSecret": { "type": "string" },
        "endpointKey": { "type": "string" }
      },
      "required": ["mode", "endpointKey"],
      "additionalProperties": true
    },
    "cloudfront": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "privateKeySecretKey": { "type": "string" }
      },
      "required": ["enabled", "privateKeySecretKey"],
      "additionalProperties": true
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "required": ["enabled"]
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string" }
          ]
        }
      },
      "required": ["enabled"]
    }
  },
  "required": [
    "global",
    "serviceAccount",
    "frontend",
    "backend",
    "externalDatabase",
    "postgresql",
    "migrations",
    "storage",
    "cloudfront",
    "networkPolicy",
    "podDisruptionBudget"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "externalDatabase": {
            "properties": {
              "enabled": { "const": true }
            },
            "required": ["enabled"]
          }
        },
        "required": ["externalDatabase"]
      },
      "then": {
        "properties": {
          "externalDatabase": {
            "required": ["host", "username", "existingSecret", "passwordKey"]
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
